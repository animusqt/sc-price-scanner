{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sc-truckers.example/schemas/v2/market-report.json",
  "title": "SCIP player market report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_report_id",
    "location",
    "patch_version",
    "server_shard",
    "observed_at",
    "ocr_confidence",
    "source",
    "commodities"
  ],
  "properties": {
    "client_report_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 100
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "patch_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "server_shard": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "ocr_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "enum": [
        "player-scan",
        "manual"
      ]
    },
    "commodities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commodity"
        ],
        "anyOf": [
          {
            "required": [
              "buy"
            ],
            "properties": {
              "buy": {
                "type": "integer"
              }
            }
          },
          {
            "required": [
              "sell"
            ],
            "properties": {
              "sell": {
                "type": "integer"
              }
            }
          },
          {
            "required": [
              "stock"
            ],
            "properties": {
              "stock": {
                "type": "integer"
              }
            }
          },
          {
            "required": [
              "demand"
            ],
            "properties": {
              "demand": {
                "type": "integer"
              }
            }
          }
        ],
        "properties": {
          "commodity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "buy": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000
          },
          "sell": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000
          },
          "stock": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000
          },
          "demand": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000
          },
          "demand_label": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          }
        }
      }
    },
    "inventory": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commodity",
          "quantity"
        ],
        "properties": {
          "commodity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "profit_direction": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "up",
              "down",
              null
            ]
          }
        }
      }
    }
  }
}
