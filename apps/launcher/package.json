{
  "name": "sc-price-scanner-overlay",
  "version": "2.0.0",
  "description": "Always-on-top overlay for SC Price Scanner",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.sctruckers.scanner-overlay",
    "productName": "SC Price Scanner Overlay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "overlay.css",
      "renderer.js",
      "region-preview.html",
      "region-preview.css",
      "icon.png",
      "icon.ico",
      "icon.icns"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
