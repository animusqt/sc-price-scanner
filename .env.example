# Local development only. Copy to .env and replace every value before deployment.
APP_ENV=development
POSTGRES_DB=scip
POSTGRES_USER=scip
POSTGRES_PASSWORD=replace_with_a_long_random_url_safe_database_password
REDIS_PASSWORD=replace_with_a_long_random_redis_password
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
SITE_DOMAIN=market.example.com

# Optional SC-Truckers/Lovable OCR submission target. Set only after the website
# accepts the documented POST /api/ocr-submit ReportCreate JSON contract.
SC_TRUCKERS_API_BASE_URL=
SC_TRUCKERS_API_DOCUMENTATION_URL=
SC_TRUCKERS_API_TOKEN=
SCIP_OCR_SERVICE_URL=http://127.0.0.1:8001

# Optional catalog synchronizers. Each URL must be an HTTPS endpoint on the
# provider's approved host and return SCIP's normalized catalog JSON envelope.
SCIP_IMPORT_SC_TRADE_TOOLS_URL=
SCIP_IMPORT_SC_TRADE_TOOLS_TOKEN=
SCIP_IMPORT_UEX_URL=
SCIP_IMPORT_UEX_TOKEN=
SCIP_IMPORT_HAULER_URL=
SCIP_IMPORT_HAULER_TOKEN=
SCIP_IMPORT_ERKUL_URL=
SCIP_IMPORT_ERKUL_TOKEN=
SCIP_IMPORT_STAR_CITIZEN_WIKI_URL=
SCIP_IMPORT_STAR_CITIZEN_WIKI_TOKEN=
SCIP_IMPORT_LOVABLE_URL=
SCIP_IMPORT_LOVABLE_TOKEN=
# For Supabase, use the project URL (https://<project>.supabase.co).
# Token is the project's public anon/publishable key when table RLS allows reads.
# Required: exact project host, without a scheme.
SCIP_IMPORT_LOVABLE_ALLOWED_HOST=
