# Local development only. Copy to .env and replace every value before deployment.
APP_ENV=development
WEB_PORT=8080
APP_WEB_URL=http://localhost:8080
POSTGRES_DB=scip
POSTGRES_USER=scip
POSTGRES_PASSWORD=replace_with_a_long_random_url_safe_database_password
REDIS_PASSWORD=replace_with_a_long_random_redis_password
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
SITE_DOMAIN=market.example.com

# Discord OAuth and bot-based guild/role verification; leave blank for local-only development.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
DISCORD_VERIFIED_ROLE_ID=
SCIP_MODERATOR_DISCORD_IDS=

# Provider ingestion is disabled until authorized API contracts and field mappings are configured.
UEX_API_BASE_URL=
UEX_API_DOCUMENTATION_URL=
SC_TRADE_TOOLS_API_BASE_URL=
SC_TRADE_TOOLS_API_DOCUMENTATION_URL=
HAULER_API_BASE_URL=
HAULER_API_DOCUMENTATION_URL=
SC_TRUCKERS_API_BASE_URL=
SC_TRUCKERS_API_DOCUMENTATION_URL=
ERKUL_API_BASE_URL=
ERKUL_API_DOCUMENTATION_URL=
SC_WIKI_API_BASE_URL=
SC_WIKI_API_DOCUMENTATION_URL=
