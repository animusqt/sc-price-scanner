# Local development only. Copy to .env and replace every value before deployment.
APP_ENV=development
POSTGRES_DB=scip
POSTGRES_USER=scip
POSTGRES_PASSWORD=replace_with_a_long_random_url_safe_database_password
REDIS_PASSWORD=replace_with_a_long_random_redis_password
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
SITE_DOMAIN=market.example.com

# Optional SC-Truckers/Lovable OCR submission target. Set only after the website
# accepts the documented POST /api/ocr-submit ReportCreate JSON contract.
SC_TRUCKERS_API_BASE_URL=
SC_TRUCKERS_API_DOCUMENTATION_URL=
SC_TRUCKERS_API_TOKEN=
SCIP_OCR_SERVICE_URL=http://127.0.0.1:8001
